# Secreto para firmar la sesión (obligatorio en producción, mínimo 32 caracteres)
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Ruta de la base de datos SQLite (opcional)
DATABASE_PATH=./data/twolove.db
# Clave AES-256 para cifrar documentos sensibles en reposo (32 bytes en base64: `openssl rand -base64 32`).
# Si no se define, se deriva de AUTH_SECRET.
UPLOAD_ENCRYPTION_KEY=
# Pagos reales con Stripe Checkout (si se omiten, la billetera funciona en modo demostración)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública de la app (URLs de retorno de Stripe y tarjeta social Open Graph)
APP_URL=https://twolove.app
# Correo saliente con Resend (sin clave, los correos quedan registrados en /admin/correos en modo demostración)
RESEND_API_KEY=
EMAIL_FROM=TWO LOVE <hola@twolove.app>
# Tipo de cambio oficial: fuente del dólar observado (por defecto mindicador.cl) y secreto del cron diario /api/cron/fx
FX_SOURCE_URL=
CRON_SECRET=
